<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>System Profiles</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet"/>
<style>
  @font-face {
    font-family: 'OpenDyslexic';
    src: url('https://cdn.jsdelivr.net/npm/open-dyslexic@1.0.3/open-dyslexic-regular.woff') format('woff');
    font-weight: normal;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { background: var(--bg); color: var(--text); font-family: var(--font); min-height: 100vh; }
  :root {
    --bg: #080614; --surface: #12101e; --border: #1a1730; --muted: #504876;
    --text: #e8e0f8; --font: 'DM Sans', sans-serif; --display-font: 'Playfair Display', serif;
  }
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: var(--bg); }
  ::-webkit-scrollbar-thumb { background: var(--border); border-radius: 3px; }
  input, textarea, select { caret-color: #9333ea; font-family: var(--font); }
  input:focus, textarea:focus { border-color: #6d28d9 !important; outline: none; }
  button { cursor: pointer; font-family: var(--font); }

  /* Layout */
  #app { min-height: 100vh; padding-bottom: 80px; }
  .header {
    background: var(--surface); border-bottom: 1px solid var(--border);
    padding: 18px 26px; position: sticky; top: 0; z-index: 100;
  }
  .header-inner {
    max-width: 950px; margin: 0 auto; display: flex; align-items: center;
    justify-content: space-between; flex-wrap: wrap; gap: 10px;
  }
  .system-title { color: var(--text); font-family: var(--display-font); font-size: 22px; font-weight: 400; }
  .system-sub { color: var(--muted); font-size: 9px; letter-spacing: 0.18em; text-transform: uppercase; margin-top: 2px; opacity: 0.6; }
  .header-btns { display: flex; gap: 8px; align-items: center; }
  .main { max-width: 950px; margin: 0 auto; padding: 28px 22px 0; }

  /* Buttons */
  .btn-ghost { padding: 7px 15px; background: transparent; border: 1px solid var(--border); border-radius: 7px; color: var(--muted); font-size: 12px; }
  .btn-ghost:hover { border-color: var(--muted); }
  .btn-purple { padding: 7px 15px; background: linear-gradient(135deg,#6d28d9,#9333ea); border: none; border-radius: 7px; color: #fff; font-size: 12px; font-weight: 700; }
  .btn-edit { padding: 7px 15px; border: 1px solid var(--border); border-radius: 7px; font-size: 12px; background: transparent; color: var(--muted); }
  .btn-edit.active { background: rgba(147,51,234,0.15); color: #9333ea; font-weight: 700; border-color: rgba(147,51,234,0.3); }
  .btn-icon { width: 34px; height: 34px; background: transparent; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); font-size: 16px; display: flex; align-items: center; justify-content: center; padding: 0; flex-shrink: 0; }
  .btn-icon:hover { border-color: var(--muted); }
  .btn-save { padding: 8px 16px; background: linear-gradient(135deg,#065f46,#10b981); border: none; border-radius: 8px; color: #fff; font-size: 13px; font-weight: 700; }
  .btn-cancel { padding: 8px 14px; background: transparent; border: 1px solid var(--border); border-radius: 8px; color: var(--muted); font-size: 13px; }
  .btn-danger { position: absolute; top: 8px; left: 8px; background: #2a1a1a; border: 1px solid #5a2020; border-radius: 5px; color: #f87171; width: 22px; height: 22px; font-size: 13px; display: flex; align-items: center; justify-content: center; padding: 0; }

  /* Cards */
  .gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(175px, 1fr)); gap: 13px; }
  .alter-card {
    position: relative; border-radius: 18px; background: var(--surface);
    border: 1.5px solid var(--border); padding: 24px 18px 18px;
    transition: all 0.22s; cursor: pointer; text-align: center;
  }
  .alter-card:hover { transform: translateY(-4px); }
  .card-fronting-badge {
    position: absolute; top: 10px; right: 10px; border-radius: 20px;
    padding: 2px 9px; font-size: 9px; font-weight: 700; color: #fff; letter-spacing: 0.07em;
  }
  .card-emoji { font-size: 40px; margin-bottom: 10px; display: block; }
  .card-name { font-family: var(--display-font); font-size: 18px; margin-bottom: 3px; color: var(--text); }
  .card-pronouns { font-size: 11px; margin-bottom: 9px; font-weight: 600; }
  .card-role { background: rgba(0,0,0,0.2); border-radius: 7px; padding: 3px 9px; display: inline-block; font-size: 10px; color: var(--muted); }

  /* Fronting banner */
  .fronting-banner {
    background: var(--surface); border: 1px solid var(--border); border-radius: 13px;
    padding: 13px 20px; margin-bottom: 22px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  }
  .fronting-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; box-shadow: 0 0 7px #10b981; }
  .fronting-label { color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .fronting-chip {
    display: inline-flex; align-items: center; gap: 5px; background: rgba(0,0,0,0.2);
    border-radius: 20px; padding: 3px 12px; cursor: pointer; border: 1px solid transparent; font-size: 12px; font-weight: 700;
  }

  /* Profile detail */
  .profile-back { background: transparent; border: none; color: var(--muted); font-size: 13px; padding: 0 0 20px; display: flex; align-items: center; gap: 6px; }
  .profile-hero {
    background: var(--surface); border-radius: 22px; padding: 30px;
    margin-bottom: 16px; position: relative; overflow: hidden;
  }
  .profile-main { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 26px 28px; margin-bottom: 14px; }
  .profile-name { font-family: var(--display-font); font-size: 30px; font-weight: 700; color: var(--text); margin-bottom: 3px; }
  .profile-pronouns { font-size: 13px; font-weight: 600; margin-bottom: 8px; }
  .fronting-tag { border-radius: 20px; padding: 3px 11px; font-size: 10px; font-weight: 700; color: #fff; letter-spacing: 0.06em; display: inline-block; }

  /* Section header */
  .section-header { display: flex; align-items: center; gap: 12px; margin: 26px 0 14px; }
  .section-line-l { height: 1px; flex: 1; }
  .section-line-r { height: 1px; flex: 1; }
  .section-label { font-size: 9px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; white-space: nowrap; }

  /* Fields */
  .field { margin-bottom: 16px; }
  .field-label { display: block; color: var(--muted); font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 5px; }
  .field-value { font-size: 13px; line-height: 1.72; white-space: pre-wrap; color: var(--text); }
  .field-empty { opacity: 0.4; font-style: italic; color: var(--muted); }
  .field-input { width: 100%; padding: 9px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 13px; }
  .field-textarea { width: 100%; min-height: 70px; padding: 9px 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px; color: var(--text); font-size: 13px; resize: vertical; line-height: 1.65; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0 22px; }

  /* Collapsible */
  .collapsible { border-radius: 11px; overflow: hidden; margin-bottom: 8px; }
  .collapsible-btn { width: 100%; padding: 11px 16px; background: transparent; border: none; display: flex; align-items: center; justify-content: space-between; gap: 8px; }
  .collapsible-btn.open { background: rgba(255,255,255,0.03); }
  .collapsible-label { font-size: 9px; font-weight: 700; letter-spacing: 0.15em; text-transform: uppercase; }
  .collapsible-arrow { font-size: 13px; transition: transform 0.2s; display: inline-block; }
  .collapsible-arrow.open { transform: rotate(180deg); }
  .collapsible-content { padding: 2px 16px 16px; }

  /* Toggle */
  .toggle-track { width: 44px; height: 24px; border-radius: 12px; position: relative; transition: background 0.2s; flex-shrink: 0; cursor: pointer; }
  .toggle-thumb { position: absolute; top: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; transition: left 0.2s; box-shadow: 0 1px 4px rgba(0,0,0,0.3); }

  /* Notes */
  .notes-section { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 26px 28px; }
  .note-item { background: rgba(0,0,0,0.2); border-radius: 10px; padding: 11px 15px; }
  .note-author { font-size: 11px; font-weight: 700; }
  .note-date { font-size: 10px; color: var(--muted); opacity: 0.6; }
  .note-text { font-size: 13px; line-height: 1.65; margin-top: 4px; color: var(--text); }

  /* Modal overlay */
  .modal-overlay { position: fixed; inset: 0; background: rgba(8,6,18,0.88); display: flex; align-items: center; justify-content: center; z-index: 9999; backdrop-filter: blur(8px); }
  .modal-box { background: var(--surface); border: 1px solid var(--border); border-radius: 18px; padding: 38px 42px; width: 350px; box-shadow: 0 30px 90px rgba(0,0,0,0.7); }
  .modal-title { font-family: var(--display-font); font-size: 22px; text-align: center; color: var(--text); margin-bottom: 6px; }
  .modal-sub { color: var(--muted); font-size: 13px; text-align: center; margin-bottom: 24px; }

  /* Settings */
  .settings-box { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; padding: 32px 36px; width: 500px; max-width: 95vw; max-height: 90vh; overflow-y: auto; box-shadow: 0 30px 90px rgba(0,0,0,0.7); }
  .settings-label { display: block; color: var(--muted); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 12px; }
  .bg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .bg-preset-btn { padding: 10px 8px; border-radius: 10px; border: 2px solid transparent; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 5px; transition: border 0.15s; }
  .text-presets { display: flex; gap: 8px; flex-wrap: wrap; }
  .text-preset-btn { padding: 7px 12px; border-radius: 8px; border: 2px solid transparent; cursor: pointer; display: flex; align-items: center; gap: 7px; transition: border 0.15s; }
  .color-dot { width: 14px; height: 14px; border-radius: 50%; border: 1px solid rgba(128,128,128,0.3); flex-shrink: 0; }
  .palette { display: flex; gap: 7px; flex-wrap: wrap; }
  .palette-dot { width: 20px; height: 20px; border-radius: 50%; cursor: pointer; border: 3px solid transparent; transition: border 0.15s; flex-shrink: 0; }
  .emoji-picker { display: flex; gap: 5px; flex-wrap: wrap; }
  .emoji-btn { font-size: 18px; padding: 3px; border-radius: 5px; border: none; background: transparent; cursor: pointer; }
  .emoji-btn.selected { background: var(--border); }
  .hero-row { display: flex; align-items: flex-start; gap: 20px; flex-wrap: wrap; position: relative; }
  .hero-meta { flex: 1; min-width: 180px; }
  .hero-actions { display: flex; gap: 7px; flex-direction: column; flex-shrink: 0; }
  .edit-inline { background: transparent; border: none; border-bottom: 2px solid; color: var(--text); font-size: 28px; width: 100%; padding: 0 0 3px; margin-bottom: 5px; }
  .edit-inline-sm { background: transparent; border: none; border-bottom: 1px solid; font-size: 13px; width: 100%; padding: 0 0 3px; }
  .add-form { background: var(--surface); border: 1px solid var(--border); border-radius: 22px; padding: 26px 28px; margin-bottom: 22px; }

  @media (max-width: 600px) {
    .two-col { grid-template-columns: 1fr; }
    .modal-box { padding: 28px 24px; width: 92vw; }
    .settings-box { padding: 24px 20px; }
    .bg-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
</head>
<body>
<div id="app"></div>

<script>
// ─── Storage (localStorage) ──────────────────────────────────────────────────
const store = {
  get(key) { try { const v = localStorage.getItem(key); return v ? JSON.parse(v) : null; } catch { return null; } },
  set(key, val) { try { localStorage.setItem(key, JSON.stringify(val)); } catch {} },
};

// ─── Data ────────────────────────────────────────────────────────────────────
const EDIT_PASSWORD = "system2024";

const EMPTY_ALTER = {
  id:"", name:"", pronouns:"", role:"", roleDescription:"", age:"", preferredLabels:"",
  appearance:"", music:"", mediaFaves:"", hobbies:"", systemSkills:"",
  otherLikes:"", dislikes:"", mannerisms:"", internalTraits:"", freeSpace:"",
  emotionalReg:"", loveLanguages:"", personalProblems:"", triggers:"",
  substances:"", kinks:"", emoji:"✨", color:"#a78bfa", isFronting:false,
};

const PALETTE = ["#f87171","#fb923c","#fbbf24","#a3e635","#34d399","#22d3ee","#60a5fa","#a78bfa","#f472b6","#e879f9","#94a3b8","#f9a8d4","#c084fc","#86efac","#fdba74"];
const EMOJIS = ["🌙","⭐","🌸","🔥","🌊","🍃","💎","🦋","🌈","🐺","🦊","🐉","🌺","✨","🎭","🗡️","🛡️","🎨","🎵","📚","💫","🌻","🦅","🐈","🌿","🧸","🪷","🌑","☁️","🫧","🪞","🕯️","🧿","🫀","🦴","🎪"];

const BG_PRESETS = [
  { label:"Midnight", bg:"#080614", surface:"#12101e", border:"#1a1730", muted:"#504876" },
  { label:"Slate",    bg:"#0d1117", surface:"#161b22", border:"#21262d", muted:"#4a5568" },
  { label:"Forest",  bg:"#071a0f", surface:"#0f2419", border:"#1a3a28", muted:"#4a7c59" },
  { label:"Dusk",    bg:"#120a14", surface:"#1e1020", border:"#2a1830", muted:"#6a4a70" },
  { label:"Ocean",   bg:"#06111a", surface:"#0d1e2e", border:"#162840", muted:"#3a6080" },
  { label:"Ember",   bg:"#140a06", surface:"#22120a", border:"#331a0e", muted:"#7a4030" },
  { label:"Soft Light", bg:"#f5f0ff", surface:"#ffffff", border:"#e2d9f3", muted:"#7c6f9e" },
  { label:"Warm Paper", bg:"#fdf8f0", surface:"#ffffff", border:"#e8ddc8", muted:"#8a7060" },
  { label:"Sage",    bg:"#f0f5f0", surface:"#ffffff", border:"#d4e0d4", muted:"#5a7a5a" },
];

const TEXT_PRESETS = [
  { label:"Lavender", value:"#e8e0f8" }, { label:"White",   value:"#ffffff" },
  { label:"Cream",    value:"#fdf8e8" }, { label:"Soft Blue",value:"#dbeafe" },
  { label:"Mint",     value:"#d1fae5" }, { label:"Peach",    value:"#fde8d8" },
  { label:"Charcoal", value:"#1a1a2e" }, { label:"Dark Slate",value:"#1e293b" },
  { label:"Dark Forest",value:"#14281e"},
];

// ─── App State ───────────────────────────────────────────────────────────────
let state = {
  alters: store.get("alters_v3") || [{
    ...EMPTY_ALTER, id:"demo1", name:"Example Alter", pronouns:"they/them",
    role:"Host", roleDescription:"Handles most day-to-day functioning and fronts the most often.",
    age:"Matches body age", preferredLabels:"Alter, system member",
    appearance:"Tall with dark hair, usually seen in cozy sweaters in the inner world.",
    music:"Lo-fi playlists, indie folk, soft ambient",
    mediaFaves:"Studio Ghibli films, cozy slice-of-life anime",
    hobbies:"Reading, journaling, long walks",
    systemSkills:"Communication, keeping the schedule, interfacing with strangers",
    otherLikes:"Rain sounds, candles, old books",
    dislikes:"Loud unexpected noises, being interrupted",
    mannerisms:"Tends to trail off mid-sentence, fidgets with sleeves, light masking",
    internalTraits:"Compassionate, quietly anxious, deeply empathetic",
    freeSpace:"This is just an example — head into Edit Mode to build your real profiles!",
    emotionalReg:"Moderate regulation, high empathy, expresses through writing",
    loveLanguages:"1. Words of affirmation  2. Quality time  3. Acts of service",
    personalProblems:"Tends to take on too much responsibility",
    triggers:"Raised voices, sudden abandonment language",
    substances:"Caffeine okay, alcohol complicated", kinks:"",
    emoji:"🌙", color:"#a78bfa", isFronting:true,
  }],
  notes: store.get("notes_v2") || [],
  systemName: store.get("systemName_v1") || "Our System",
  settings: store.get("userSettings_v1") || { bgPreset:0, textPreset:0, dyslexiaFont:false },
  editMode: false,
  selected: null,
  view: "gallery", // gallery | profile | settings | password | addAlter
  editingAlter: null,
  editingName: false,
  showAddForm: false,
  pendingAction: null,
  // collapsible open states per-profile
  openSections: {},
  kinkVisible: false,
};

function save() {
  store.set("alters_v3", state.alters);
  store.set("notes_v2", state.notes);
  store.set("systemName_v1", state.systemName);
  store.set("userSettings_v1", state.settings);
}

function applyTheme(s) {
  const bg = BG_PRESETS[s.bgPreset] || BG_PRESETS[0];
  const text = TEXT_PRESETS[s.textPreset]?.value || "#e8e0f8";
  const font = s.dyslexiaFont ? "'OpenDyslexic','Comic Sans MS',cursive" : "'DM Sans',sans-serif";
  const displayFont = s.dyslexiaFont ? "'OpenDyslexic','Comic Sans MS',cursive" : "'Playfair Display',serif";
  const root = document.documentElement;
  root.style.setProperty('--bg', bg.bg);
  root.style.setProperty('--surface', bg.surface);
  root.style.setProperty('--border', bg.border);
  root.style.setProperty('--muted', bg.muted);
  root.style.setProperty('--text', text);
  root.style.setProperty('--font', font);
  root.style.setProperty('--display-font', displayFont);
  document.body.style.background = bg.bg;
}

function uid() { return Math.random().toString(36).slice(2,10); }

// ─── Render helpers ──────────────────────────────────────────────────────────
function h(tag, attrs, ...children) {
  const el = document.createElement(tag);
  if (attrs) Object.entries(attrs).forEach(([k,v]) => {
    if (k === 'style' && typeof v === 'object') Object.assign(el.style, v);
    else if (k.startsWith('on')) el.addEventListener(k.slice(2).toLowerCase(), v);
    else if (k === 'className') el.className = v;
    else el.setAttribute(k, v);
  });
  children.flat(Infinity).forEach(c => {
    if (c == null || c === false) return;
    el.appendChild(typeof c === 'string' ? document.createTextNode(c) : c);
  });
  return el;
}

// ─── Components ──────────────────────────────────────────────────────────────

function renderSectionHeader(label, color) {
  return h('div', {className:'section-header'}, [
    h('div', {className:'section-line-l', style:{background:`linear-gradient(90deg,${color}55,transparent)`}}),
    h('span', {className:'section-label', style:{color}},[label]),
    h('div', {className:'section-line-r', style:{background:`linear-gradient(90deg,transparent,${color}55)`}}),
  ]);
}

function renderField(label, value, editing, onInput, multiline, placeholder) {
  const isEmpty = !value || value.trim() === '';
  return h('div', {className:'field'}, [
    h('label', {className:'field-label'}, [label]),
    editing
      ? (multiline
          ? h('textarea', {className:'field-textarea', placeholder:placeholder||'', onInput: e => onInput(e.target.value), value:value||''}, [])
          : h('input', {className:'field-input', type:'text', placeholder:placeholder||'', value:value||'', onInput: e => onInput(e.target.value)})
        )
      : h('p', {className:'field-value' + (isEmpty?' field-empty':'')}, [isEmpty ? 'Not filled in' : value])
  ]);
}
// textarea value workaround
function setTextareaValue(el, val) { if (el && el.tagName === 'TEXTAREA') el.value = val || ''; }

function renderToggle(checked, onChange, color) {
  const track = h('div', {
    className:'toggle-track',
    style:{background: checked ? color : 'var(--border)', cursor:'pointer'},
    onClick: () => onChange(!checked)
  }, [
    h('div', {className:'toggle-thumb', style:{left: checked ? '22px' : '3px'}})
  ]);
  return track;
}

function renderCollapsible(labelText, color, defaultOpen, renderContent, sectionKey) {
  const isOpen = state.openSections[sectionKey] !== undefined ? state.openSections[sectionKey] : defaultOpen;
  const arrow = h('span', {className:'collapsible-arrow' + (isOpen?' open':'')}, ['▾']);
  const content = h('div', {className:'collapsible-content', style:{display: isOpen?'block':'none'}});
  if (isOpen) content.appendChild(renderContent());

  const btn = h('button', {
    className:'collapsible-btn' + (isOpen?' open':''),
    style:{border:'none'},
    onClick: () => {
      state.openSections[sectionKey] = !isOpen;
      render();
    }
  }, [
    h('span', {className:'collapsible-label', style:{color}}, [labelText]),
    arrow
  ]);

  const wrapper = h('div', {className:'collapsible', style:{border:`1px solid ${color}2e`}}, [btn, content]);
  return wrapper;
}

// ─── Password Modal ──────────────────────────────────────────────────────────
function renderPasswordModal(onSuccess, onCancel) {
  let inputEl;
  const errMsg = h('p', {style:{color:'#f87171',fontSize:'12px',marginBottom:'14px',display:'none'}}, ['Incorrect password']);

  const attempt = () => {
    if (inputEl.value === EDIT_PASSWORD) { onSuccess(); }
    else { errMsg.style.display='block'; inputEl.value=''; inputEl.focus(); }
  };

  inputEl = h('input', {
    type:'password', className:'field-input', placeholder:'Password',
    style:{marginBottom:'18px'},
    onKeydown: e => { if (e.key==='Enter') attempt(); }
  });

  const box = h('div', {className:'modal-box'}, [
    h('div', {style:{fontSize:'30px',textAlign:'center',marginBottom:'8px'}}, ['🔒']),
    h('h3', {className:'modal-title'}, ['Edit Mode']),
    h('p', {className:'modal-sub'}, ['System password required']),
    inputEl, errMsg,
    h('div', {style:{display:'flex',gap:'10px'}}, [
      h('button', {className:'btn-ghost', style:{flex:'1',padding:'10px'}, onClick:onCancel}, ['Cancel']),
      h('button', {className:'btn-purple', style:{flex:'1',padding:'10px'}, onClick:attempt}, ['Enter']),
    ]),
    h('p', {style:{color:'var(--border)',fontSize:'11px',textAlign:'center',marginTop:'16px'}}, ['Default: system2024']),
  ]);

  const overlay = h('div', {className:'modal-overlay'}, [box]);
  setTimeout(() => inputEl.focus(), 50);
  return overlay;
}

// ─── Settings Panel ──────────────────────────────────────────────────────────
function renderSettingsPanel() {
  let draft = {...state.settings};

  function buildPanel() {
    const previewBg = BG_PRESETS[draft.bgPreset] || BG_PRESETS[0];
    const previewText = TEXT_PRESETS[draft.textPreset]?.value || '#e8e0f8';
    const previewFont = draft.dyslexiaFont ? "'OpenDyslexic','Comic Sans MS',cursive" : "'DM Sans',sans-serif";
    const previewDisplayFont = draft.dyslexiaFont ? "'OpenDyslexic','Comic Sans MS',cursive" : "'Playfair Display',serif";

    // BG presets
    const bgGrid = h('div', {className:'bg-grid'}, BG_PRESETS.map((p, i) =>
      h('button', {
        className:'bg-preset-btn',
        style:{background:p.bg, borderColor: draft.bgPreset===i ? '#9333ea' : p.border},
        onClick: () => { draft.bgPreset=i; rebuildPanel(); }
      }, [
        h('div', {style:{display:'flex',gap:'3px'}}, [
          h('div', {style:{width:'12px',height:'12px',borderRadius:'3px',background:p.surface,border:`1px solid ${p.border}`}}),
          h('div', {style:{width:'12px',height:'12px',borderRadius:'3px',background:p.muted}}),
        ]),
        h('span', {style:{color:previewText,fontSize:'10px',opacity:'0.8',fontFamily:previewFont}}, [p.label]),
      ])
    ));

    // Text presets
    const textRow = h('div', {className:'text-presets'}, TEXT_PRESETS.map((p, i) =>
      h('button', {
        className:'text-preset-btn',
        style:{background:previewBg.bg, borderColor: draft.textPreset===i ? '#9333ea' : previewBg.border},
        onClick: () => { draft.textPreset=i; rebuildPanel(); }
      }, [
        h('div', {className:'color-dot', style:{background:p.value}}),
        h('span', {style:{color:p.value,fontSize:'11px',fontFamily:previewFont,whiteSpace:'nowrap'}}, [p.label]),
      ])
    ));

    // Dyslexia toggle
    const toggleTrack = renderToggle(draft.dyslexiaFont, (v) => { draft.dyslexiaFont=v; rebuildPanel(); }, '#9333ea');
    const dyslexiaPreview = draft.dyslexiaFont
      ? h('p', {style:{fontFamily:"'OpenDyslexic','Comic Sans MS',cursive",color:'var(--text)',fontSize:'13px',margin:'8px 0 0',lineHeight:'1.7',borderTop:'1px solid var(--border)',paddingTop:'10px'}},
          ['Preview: The quick brown fox jumps over the lazy dog. Each letter has a weighted bottom to help with orientation.'])
      : null;

    const dyslexiaRow = h('div', {style:{background:'rgba(255,255,255,0.03)',borderRadius:'12px',padding:'16px 18px',marginBottom:'28px'}}, [
      h('div', {style:{display:'flex',alignItems:'center',justifyContent:'space-between',marginBottom: draft.dyslexiaFont?'0':'0'}}, [
        h('div', {}, [
          h('p', {style:{color:'var(--text)',fontSize:'14px',fontWeight:'600',marginBottom:'3px'}}, ['Dyslexia-friendly font']),
          h('p', {style:{color:'var(--muted)',fontSize:'12px'}}, ['Switches to OpenDyslexic for easier reading']),
        ]),
        h('div', {style:{marginLeft:'16px'}}, [toggleTrack]),
      ]),
      dyslexiaPreview,
    ]);

    // Preview strip
    const previewStrip = h('div', {style:{background:previewBg.bg,border:`1px solid ${previewBg.border}`,borderRadius:'12px',padding:'14px 18px',marginBottom:'24px'}}, [
      h('p', {style:{color:previewBg.muted,fontSize:'9px',fontFamily:previewFont,fontWeight:'700',letterSpacing:'0.14em',textTransform:'uppercase',marginBottom:'6px'}}, ['Live Preview']),
      h('p', {style:{color:previewText,fontFamily:previewDisplayFont,fontSize:'18px',marginBottom:'4px',fontWeight:'700'}}, ['Alter Name']),
      h('p', {style:{color:previewBg.muted,fontFamily:previewFont,fontSize:'12px'}}, ['they/them · Host']),
    ]);

    const infoBox = h('p', {style:{color:'var(--muted)',fontSize:'12px',lineHeight:'1.6',background:'rgba(255,255,255,0.04)',borderRadius:'8px',padding:'10px 14px',marginBottom:'24px'}},
      ['These settings are saved to this device/browser. Each person viewing the app can set their own preferences independently.']);

    return h('div', {className:'settings-box'}, [
      h('div', {style:{display:'flex',justifyContent:'space-between',alignItems:'center',marginBottom:'24px'}}, [
        h('h3', {style:{color:'var(--text)',fontFamily:'var(--display-font)',fontSize:'22px'}}, ['⚙ Appearance Settings']),
        h('button', {style:{background:'transparent',border:'none',color:'var(--muted)',fontSize:'22px',lineHeight:'1',padding:'0',cursor:'pointer'}, onClick:()=>{ overlayEl.remove(); }}, ['×']),
      ]),
      infoBox,
      h('label', {className:'settings-label'}, ['Background Theme']),
      h('div', {style:{marginBottom:'24px'}}, [bgGrid]),
      h('label', {className:'settings-label'}, ['Text Color']),
      h('div', {style:{marginBottom:'24px'}}, [textRow]),
      dyslexiaRow,
      previewStrip,
      h('div', {style:{display:'flex',gap:'10px'}}, [
        h('button', {
          className:'btn-purple', style:{flex:'1',padding:'11px'},
          onClick: () => {
            state.settings = {...draft};
            save();
            applyTheme(state.settings);
            overlayEl.remove();
            render();
          }
        }, ['Save settings']),
        h('button', {className:'btn-ghost', style:{padding:'11px 18px'}, onClick:()=>overlayEl.remove()}, ['Cancel']),
      ]),
    ]);
  }

  let panelEl = buildPanel();
  const overlayEl = h('div', {className:'modal-overlay', style:{zIndex:'9998'}}, [panelEl]);

  function rebuildPanel() {
    const newPanel = buildPanel();
    overlayEl.replaceChild(newPanel, panelEl);
    panelEl = newPanel;
  }

  return overlayEl;
}

// ─── Alter Card ──────────────────────────────────────────────────────────────
function renderAlterCard(alter) {
  const card = h('div', {
    className:'alter-card',
    style:{borderColor:'var(--border)'},
    onClick: () => { state.selected = alter; state.kinkVisible=false; state.openSections={}; render(); }
  }, [
    alter.isFronting ? h('div', {className:'card-fronting-badge', style:{background:alter.color}}, ['FRONTING']) : null,
    state.editMode ? h('button', {className:'btn-danger', onClick: e => {
      e.stopPropagation();
      if (!confirm('Remove this alter from the system?')) return;
      state.alters = state.alters.filter(a => a.id !== alter.id);
      if (state.selected?.id === alter.id) state.selected = null;
      save(); render();
    }}, ['×']) : null,
    h('span', {className:'card-emoji', style:{filter:`drop-shadow(0 0 12px ${alter.color}77)`}}, [alter.emoji]),
    h('h3', {className:'card-name'}, [alter.name]),
    h('p', {className:'card-pronouns', style:{color:alter.color}}, [alter.pronouns || '']),
    alter.role ? h('span', {className:'card-role'}, [alter.role]) : null,
  ]);

  card.addEventListener('mouseenter', () => { card.style.borderColor = alter.color; card.style.boxShadow = `0 10px 36px ${alter.color}28`; });
  card.addEventListener('mouseleave', () => { card.style.borderColor = 'var(--border)'; card.style.boxShadow = ''; });
  return card;
}

// ─── Add Alter Form ──────────────────────────────────────────────────────────
function renderAddForm() {
  let draft = {...EMPTY_ALTER, id:uid()};

  const nameEl = h('input', {className:'field-input', placeholder:'Name', onInput: e=>draft.name=e.target.value});
  const pronounsEl = h('input', {className:'field-input', placeholder:'Pronouns', onInput: e=>draft.pronouns=e.target.value});
  const roleEl = h('input', {className:'field-input', placeholder:'Role', onInput: e=>draft.role=e.target.value});
  const ageEl = h('input', {className:'field-input', placeholder:'e.g. 8, teen, timeless…', onInput: e=>draft.age=e.target.value});

  const paletteEl = h('div', {className:'palette'}, PALETTE.map(c => {
    const dot = h('div', {className:'palette-dot', style:{background:c,borderColor:draft.color===c?'#fff':'transparent'}, onClick:()=>{
      draft.color=c;
      document.querySelectorAll('#add-palette .palette-dot').forEach((d,i)=>d.style.borderColor=PALETTE[i]===c?'#fff':'transparent');
    }});
    return dot;
  }));
  paletteEl.id='add-palette';

  const emojiPickerEl = h('div', {className:'emoji-picker'}, EMOJIS.map(em => {
    const btn = h('button', {className:'emoji-btn'+(draft.emoji===em?' selected':''), onClick:()=>{
      draft.emoji=em;
      document.querySelectorAll('#add-emoji .emoji-btn').forEach(b=>b.classList.toggle('selected', b.textContent===em));
    }}, [em]);
    return btn;
  }));
  emojiPickerEl.id='add-emoji';

  return h('div', {className:'add-form'}, [
    h('h3', {style:{color:'var(--text)',fontFamily:'var(--display-font)',fontSize:'21px',marginBottom:'18px'}}, ['New Alter']),
    h('div', {className:'two-col'}, [
      h('div', {className:'field'}, [h('label',{className:'field-label'},['Name']), nameEl]),
      h('div', {className:'field'}, [h('label',{className:'field-label'},['Pronouns']), pronounsEl]),
      h('div', {className:'field'}, [h('label',{className:'field-label'},['Role']), roleEl]),
      h('div', {className:'field'}, [h('label',{className:'field-label'},['Age (if different)']), ageEl]),
    ]),
    h('div', {style:{marginBottom:'13px'}}, [h('p',{className:'field-label'},['Color']), paletteEl]),
    h('div', {style:{marginBottom:'18px'}}, [h('p',{className:'field-label'},['Emoji']), emojiPickerEl]),
    h('p', {style:{color:'var(--muted)',fontSize:'11px',fontStyle:'italic',marginBottom:'16px',opacity:'0.7'}}, ['You can fill in all other fields after adding.']),
    h('div', {style:{display:'flex',gap:'9px'}}, [
      h('button', {className:'btn-purple', onClick:()=>{
        if (!draft.name.trim()) return;
        state.alters.push({...draft});
        state.showAddForm=false;
        save(); render();
      }}, ['Add to System']),
      h('button', {className:'btn-cancel', onClick:()=>{state.showAddForm=false;render();}}, ['Cancel']),
    ]),
  ]);
}

// ─── Profile Detail ──────────────────────────────────────────────────────────
function renderProfile(alter) {
  let editing = false;
  let draft = {...alter};
  let noteAuthor = '';
  let noteText = '';
  const c = alter.color;

  function buildProfile() {
    const set = (field, val) => { draft[field] = val; };

    function field(label, fieldName, multiline, placeholder) {
      const val = editing ? (draft[fieldName]||'') : (alter[fieldName]||'');
      const el = renderField(label, val, editing, v => set(fieldName, v), multiline, placeholder);
      // set textarea value after DOM insertion
      if (editing && multiline) {
        const ta = el.querySelector('textarea');
        if (ta) ta.value = draft[fieldName]||'';
      }
      return el;
    }

    // Hero
    let emojiEl;
    if (editing) {
      emojiEl = h('div', {className:'emoji-picker', style:{maxWidth:'240px',marginBottom:'6px'}}, EMOJIS.map(em => {
        const btn = h('button', {className:'emoji-btn'+(draft.emoji===em?' selected':''), onClick:()=>{
          draft.emoji=em;
          document.querySelectorAll('#hero-emoji .emoji-btn').forEach(b=>b.classList.toggle('selected',b.textContent===em));
        }}, [em]);
        return btn;
      }));
      emojiEl.id='hero-emoji';
    } else {
      emojiEl = h('div', {style:{fontSize:'60px',lineHeight:'1',filter:`drop-shadow(0 0 20px ${c}99)`}}, [alter.emoji]);
    }

    let nameEl, pronounsEl;
    if (editing) {
      nameEl = h('input', {className:'edit-inline', style:{borderBottomColor:c,fontFamily:'var(--display-font)'}, value:draft.name, onInput:e=>draft.name=e.target.value});
      pronounsEl = h('input', {className:'edit-inline-sm', style:{borderBottomColor:`${c}55`,color:c}, value:draft.pronouns, onInput:e=>draft.pronouns=e.target.value});
    } else {
      nameEl = h('h2', {className:'profile-name'}, [alter.name]);
      pronounsEl = h('p', {className:'profile-pronouns', style:{color:c}}, [alter.pronouns||'']);
    }

    let statusEl;
    if (editing) {
      statusEl = h('div', {style:{display:'flex',alignItems:'center',gap:'8px',marginTop:'6px',marginBottom:'14px'}}, [
        h('span', {style:{color:'var(--muted)',fontSize:'9px',fontWeight:'700',letterSpacing:'0.14em',textTransform:'uppercase'}}, ['Fronting']),
        renderToggle(draft.isFronting, v=>{draft.isFronting=v; heroRebuild();}, c),
      ]);
    } else {
      statusEl = alter.isFronting ? h('span', {className:'fronting-tag', style:{background:c}}, ['FRONTING']) : h('span',{},[]);
    }

    let colorPickerEl = null;
    if (editing) {
      colorPickerEl = h('div', {style:{marginTop:'4px'}}, [
        h('p', {style:{color:'var(--muted)',fontSize:'9px',fontWeight:'700',letterSpacing:'0.14em',textTransform:'uppercase',marginBottom:'7px'}}, ['Accent color']),
        h('div', {className:'palette', id:'hero-palette'}, PALETTE.map(col => {
          const dot = h('div', {className:'palette-dot', style:{background:col,borderColor:draft.color===col?'#fff':'transparent'}, onClick:()=>{
            draft.color=col;
            document.querySelectorAll('#hero-palette .palette-dot').forEach((d,i)=>d.style.borderColor=PALETTE[i]===col?'#fff':'transparent');
          }});
          return dot;
        })),
      ]);
    }

    const metaEl = h('div', {className:'hero-meta'}, [nameEl, pronounsEl, statusEl, colorPickerEl]);

    let actionsEl;
    if (state.editMode) {
      if (!editing) {
        actionsEl = h('div', {className:'hero-actions'}, [
          h('button', {style:{padding:'8px 18px',background:`linear-gradient(135deg,${c}bb,${c})`,border:'none',borderRadius:'8px',color:'#fff',fontSize:'13px',fontWeight:'700'}, onClick:()=>{editing=true;rebuildProfile();}}, ['Edit']),
        ]);
      } else {
        actionsEl = h('div', {className:'hero-actions'}, [
          h('button', {className:'btn-save', onClick:()=>{
            state.alters = state.alters.map(a => a.id===draft.id ? {...draft} : a);
            state.selected = {...draft};
            save();
            editing=false;
            alter = {...draft};
            rebuildProfile();
          }}, ['Save']),
          h('button', {className:'btn-cancel', onClick:()=>{draft={...alter};editing=false;rebuildProfile();}}, ['Cancel']),
        ]);
      }
    } else {
      actionsEl = null;
    }

    const heroGlow = h('div', {style:{position:'absolute',inset:'0',background:`radial-gradient(ellipse at 72% 18%, ${c}18 0%, transparent 62%)`,pointerEvents:'none'}});
    const hero = h('div', {className:'profile-hero', style:{border:`1px solid ${c}44`}}, [
      heroGlow,
      h('div', {className:'hero-row'}, [emojiEl, metaEl, actionsEl]),
    ]);

    // Notes
    const profileNotes = state.notes.filter(n => n.alterId === alter.id);
    const notesList = profileNotes.length > 0
      ? h('div', {style:{marginTop:'22px'}}, [
          h('p', {style:{color:'var(--muted)',fontSize:'9px',fontWeight:'700',letterSpacing:'0.14em',textTransform:'uppercase',marginBottom:'12px'}}, ['Notes from friends']),
          h('div', {style:{display:'flex',flexDirection:'column',gap:'9px'}},
            [...profileNotes].reverse().map(n =>
              h('div', {className:'note-item', style:{borderLeft:`3px solid ${c}`}}, [
                h('div', {style:{display:'flex',justifyContent:'space-between',marginBottom:'4px'}}, [
                  h('span', {className:'note-author', style:{color:c}}, [n.author]),
                  h('span', {className:'note-date'}, [new Date(n.ts).toLocaleDateString()]),
                ]),
                h('p', {className:'note-text'}, [n.text]),
              ])
            )
          )
        ])
      : null;

    const authorInput = h('input', {className:'field-input', placeholder:'Your name (optional)', style:{marginBottom:'9px'}, onInput:e=>noteAuthor=e.target.value});
    const textInput = h('textarea', {className:'field-textarea', placeholder:`Write something for ${alter.name}…`, style:{marginBottom:'11px'}, onInput:e=>noteText=e.target.value});

    const notesSection = h('div', {className:'notes-section'}, [
      renderSectionHeader(`Leave a note for ${alter.name}`, c),
      authorInput,
      textInput,
      h('button', {style:{padding:'9px 20px',background:`linear-gradient(135deg,${c}bb,${c})`,border:'none',borderRadius:'8px',color:'#fff',fontSize:'13px',fontWeight:'700'}, onClick:()=>{
        if (!textInput.value.trim()) return;
        state.notes.push({id:uid(),alterId:alter.id,author:authorInput.value.trim()||'Anonymous',text:textInput.value.trim(),ts:Date.now()});
        save(); rebuildProfile();
      }}, ['Leave note ✉️']),
      notesList,
    ]);

    // Kink section
    const kinkSection = h('div', {className:'collapsible', style:{border:'1px solid #f472b625',marginBottom:'8px'}}, [
      h('button', {
        className:'collapsible-btn'+(state.kinkVisible?' open':''),
        style:{border:'none'},
        onClick:()=>{state.kinkVisible=!state.kinkVisible;rebuildProfile();}
      }, [
        h('span', {className:'collapsible-label', style:{color:'#f472b6'}}, ['🔞 Kinks']),
        h('span', {className:'collapsible-arrow'+(state.kinkVisible?' open':''), style:{color:'#f472b6'}}, ['▾']),
      ]),
      state.kinkVisible ? h('div', {className:'collapsible-content'}, [field('Kinks','kinks',true)]) : null,
    ]);

    const wrapper = h('div', {style:{maxWidth:'700px',margin:'0 auto'}}, [
      h('button', {className:'profile-back', onClick:()=>{state.selected=null;render();}}, ['← Back to gallery']),
      hero,
      h('div', {className:'profile-main'}, [
        renderSectionHeader('Identity', c),
        h('div', {className:'two-col'}, [field('Role','role',false,'e.g. Protector, Little, Host…'), field('Age (if different)','age',false,'e.g. 8, teen, timeless…')]),
        field('What that role means for us','roleDescription',true),
        field('Preferred labels','preferredLabels',false,'e.g. alter, part, little…'),
        renderSectionHeader('Appearance & Aesthetic', c),
        field('Innerworld appearance / style / aesthetic','appearance',true),
        renderSectionHeader('Tastes & Interests', c),
        field('Favorite playlist / genres / artists','music',true),
        field('Favorite movies / shows / genres','mediaFaves',true),
        field('Hobbies / interests / desired skills','hobbies',true),
        field('Other notable likes','otherLikes',true),
        renderSectionHeader('Within the System', c),
        field('Specific skills / what they\'re best at','systemSkills',true),
        renderSectionHeader('Personality', c),
        field('Mannerisms / identifiers / level of masking','mannerisms',true),
        field('Internal traits','internalTraits',true),
        field('Emotional regulation / empathy level / expression','emotionalReg',true),
        field('Love languages (in order)','loveLanguages',true,'1. …  2. …  3. …'),
        renderSectionHeader('Free Space', c),
        field('Fun facts / free space','freeSpace',true),
      ]),
      // Sensitive sections
      renderCollapsible('⚠ Personal problems / warnings','#f87171', state.editMode, ()=>field('Personal problems / warnings','personalProblems',true), 'problems'),
      renderCollapsible('⚡ Possible triggers','#fbbf24', state.editMode, ()=>field('Possible triggers','triggers',true), 'triggers'),
      renderCollapsible('— Dislikes / boundaries / pet-peeves','#94a3b8', state.editMode, ()=>field('Dislikes / boundaries / pet-peeves','dislikes',true), 'dislikes'),
      renderCollapsible('🌿 Substances','#34d399', state.editMode, ()=>field('Substances','substances',true,'e.g. caffeine fine, alcohol complicated…'), 'substances'),
      kinkSection,
      notesSection,
    ]);

    return wrapper;
  }

  let profileEl = buildProfile();

  function heroRebuild() { rebuildProfile(); }
  function rebuildProfile() {
    const newEl = buildProfile();
    if (profileEl.parentNode) profileEl.parentNode.replaceChild(newEl, profileEl);
    profileEl = newEl;
  }

  return profileEl;
}

// ─── Gallery ─────────────────────────────────────────────────────────────────
function renderGallery() {
  const fronting = state.alters.filter(a => a.isFronting);

  const frontingBanner = fronting.length > 0
    ? h('div', {className:'fronting-banner'}, [
        h('div', {style:{display:'flex',alignItems:'center',gap:'6px',flexShrink:'0'}}, [
          h('div', {className:'fronting-dot'}),
          h('span', {className:'fronting-label'}, ['Currently fronting']),
        ]),
        h('div', {style:{display:'flex',gap:'7px',flexWrap:'wrap'}},
          fronting.map(a => {
            const chip = h('span', {
              className:'fronting-chip',
              style:{borderColor:`${a.color}30`,color:a.color},
              onClick:()=>{state.selected=a;state.kinkVisible=false;state.openSections={};render();}
            }, [h('span',{style:{fontSize:'14px'}},[a.emoji]), a.name]);
            return chip;
          })
        ),
      ])
    : null;

  const addForm = state.showAddForm && state.editMode ? renderAddForm() : null;

  const gallery = state.alters.length === 0
    ? h('div', {style:{textAlign:'center',padding:'80px 20px'}}, [
        h('p', {style:{color:'var(--muted)',fontSize:'14px',opacity:'0.6'}}, ['No alters yet — enter Edit Mode to add your system members.'])
      ])
    : h('div', {className:'gallery'}, state.alters.map(renderAlterCard));

  return h('div', {}, [frontingBanner, addForm, gallery]);
}

// ─── Header ──────────────────────────────────────────────────────────────────
function renderHeader() {
  let nameDisplay;
  if (state.editMode && state.editingName) {
    const inp = h('input', {
      style:{background:'transparent',border:'none',borderBottom:'2px solid #9333ea',color:'var(--text)',fontSize:'21px',fontFamily:'var(--display-font)',padding:'0 0 2px',outline:'none',minWidth:'180px'},
      value: state.systemName,
      onInput: e => { state.systemName = e.target.value; },
      onKeydown: e => { if(e.key==='Enter'){state.editingName=false;save();render();} }
    });
    nameDisplay = h('div', {style:{display:'flex',gap:'8px',alignItems:'center'}}, [
      inp,
      h('button', {style:{background:'#6d28d9',border:'none',borderRadius:'5px',color:'#fff',cursor:'pointer',padding:'4px 11px',fontSize:'11px',fontWeight:'700'}, onClick:()=>{state.editingName=false;save();render();}}, ['Save']),
    ]);
    setTimeout(()=>inp.focus(),30);
  } else {
    nameDisplay = h('h1', {
      className:'system-title',
      style:{cursor:state.editMode?'pointer':'default'},
      onClick:()=>{ if(state.editMode){state.editingName=true;render();} }
    }, [
      state.systemName,
      state.editMode ? h('span',{style:{fontSize:'12px',color:'var(--muted)',marginLeft:'7px',opacity:'0.5'}},['✏️']) : null,
    ]);
  }

  const settingsBtn = h('button', {className:'btn-icon', title:'Appearance settings', onClick:()=>{
    document.body.appendChild(renderSettingsPanel());
  }}, ['⚙']);

  const addBtn = state.editMode && !state.selected
    ? h('button', {className:'btn-purple', onClick:()=>{state.showAddForm=true;render();}}, ['+ Add Alter'])
    : null;

  const editBtn = h('button', {
    className:'btn-edit'+(state.editMode?' active':''),
    onClick:()=>{
      if (state.editMode) { state.editMode=false; render(); }
      else {
        const modal = renderPasswordModal(
          ()=>{ state.editMode=true; modal.remove(); render(); },
          ()=>{ modal.remove(); }
        );
        document.body.appendChild(modal);
      }
    }
  }, [state.editMode ? 'Exit Edit Mode' : 'Edit Mode']);

  return h('div', {className:'header'}, [
    h('div', {className:'header-inner'}, [
      h('div', {}, [nameDisplay, h('p',{className:'system-sub'},['System Profiles'])]),
      h('div', {className:'header-btns'}, [settingsBtn, addBtn, editBtn]),
    ])
  ]);
}

// ─── Main Render ─────────────────────────────────────────────────────────────
function render() {
  applyTheme(state.settings);
  const app = document.getElementById('app');
  app.innerHTML = '';

  const header = renderHeader();
  const main = h('div', {className:'main'}, [
    state.selected ? renderProfile(state.selected) : renderGallery()
  ]);

  app.appendChild(header);
  app.appendChild(main);
}

// ─── Init ────────────────────────────────────────────────────────────────────
applyTheme(state.settings);
render();
</script>
</body>
</html>
